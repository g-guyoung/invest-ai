# Binance API 키 (공개 시세 데이터 수집만 하는 동안은 필요 없음. 추후 인증 필요 엔드포인트/자동매매 단계에서 사용)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Claude API (AI 분석 엔진용, Phase 3에서 사용)
ANTHROPIC_API_KEY=

# ── 실전 매매 (업비트 KRW 현물) ─────────────────────────────
# 업비트 Open API 키: 권한은 "자산조회" + "주문하기"만 체크 (출금하기 절대 체크 금지!)
# 허용 IP: 이 PC의 공인 IP를 업비트에서 등록해야 주문이 통과됨
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 실전 전환 이중 잠금 — 두 줄이 모두 정확히 있어야 실전. 평소에는 두 줄 모두 비워두거나 삭제.
# LIVE_TRADING=true
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISKS
