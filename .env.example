# Binance API 키 (공개 시세 데이터 수집만 하는 동안은 필요 없음. 추후 인증 필요 엔드포인트/자동매매 단계에서 사용)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Claude API (AI 분석 엔진용, Phase 3에서 사용)
ANTHROPIC_API_KEY=

# ── 실전 매매 (업비트 KRW 현물) ─────────────────────────────
# 업비트 Open API 키: 권한은 "자산조회" + "주문하기"만 체크 (출금하기 절대 체크 금지!)
# 허용 IP: 이 PC의 공인 IP를 업비트에서 등록해야 주문이 통과됨
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 실전 전환 이중 잠금 — 두 줄이 모두 정확히 있어야 실전. 평소에는 두 줄 모두 비워두거나 삭제.
# LIVE_TRADING=true
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISKS

# ── 주식 매매 (한국투자증권 KIS Open API — 한국 주식 + 미국 주식) ──────────
# KIS Developers(apiportal.koreainvestment.com)에서 앱키 발급. 모의투자 앱키와 실전 앱키는 서로 다르다.
# KIS_ENV: vts = 모의투자(가짜 돈, 기본값) / prod = 실전(실제 돈 — 위 LIVE_TRADING 두 줄이 있어야만 동작)
KIS_ENV=vts
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호: 8자리-2자리 (예: 50123456-01). 모의투자는 모의투자 계좌번호를 넣는다.
KIS_ACCOUNT_NO=

# 매매 대상 모드: universe = 전 종목(코스피·코스닥 / NASDAQ·NYSE·AMEX)에서 매일 스크리닝 (기본)
#                list     = 아래 KIS_*_SYMBOLS에 적은 종목만 매매
KIS_KR_MODE=universe
KIS_US_MODE=universe
# list 모드: 매매 종목 / universe 모드: 항상 함께 살펴볼 추가 종목 (비워도 됨)
KIS_KR_SYMBOLS=
KIS_US_SYMBOLS=
# 시장별 자금 상한 (계좌에 돈이 더 있어도 이 금액까지만 사용)
KIS_KR_CAPITAL_KRW=300000
KIS_US_CAPITAL_USD=1000
# universe 모드: 최대 동시 보유 종목 수 (종목당 예산 = 자금 상한 ÷ 이 값, 1주가 예산보다 비싼 종목은 제외)
KIS_KR_MAX_POSITIONS=5
KIS_US_MAX_POSITIONS=5
# universe 모드 필터: 최소 주가, 20일 평균 거래대금 하한(유동성)
KIS_KR_MIN_PRICE=1000
KIS_KR_MIN_TRADED_VALUE=1000000000
KIS_US_MIN_PRICE=5
KIS_US_MIN_TRADED_VALUE=20000000
KIS_SCREEN_MAX_CANDIDATES=10
KIS_INCLUDE_ETF=false

# 브로커 1회 주문 금액 상한 (봇/전략 버그가 있어도 한 번에 이 이상은 안 나감)
KIS_MAX_ORDER_KRW=500000
KIS_MAX_ORDER_USD=500
# 미국 주식은 시장가가 없어 "현재가 ± 슬리피지" 지정가로 주문 (0.005 = 0.5%)
KIS_US_SLIPPAGE_PCT=0.005
# (선택) 미국 거래소 고정 지정. 비우면 시세 조회로 자동 탐색. 예: KO:NYSE,SPY:AMEX
KIS_US_EXCHANGES=
