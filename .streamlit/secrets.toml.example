# Streamlit Cloud Secrets 예시
# 실제 파일은 .streamlit/secrets.toml (로컬) 또는 Streamlit Cloud 설정에서 관리

# Supabase
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-supabase-public-key"

# Anthropic Claude API
ANTHROPIC_API_KEY = "sk-ant-api03-xxxxxxxxxx"

# Binance (향후 실거래용)
BINANCE_API_KEY = "your-binance-api-key"
BINANCE_API_SECRET = "your-binance-api-secret"

# GitHub (향후 자동 배포용)
GITHUB_TOKEN = "ghp_xxxxxxxxxx"

# 투자 규모 설정
INITIAL_BALANCE_KR = 1000000  # 한국 주식 100만원
INITIAL_BALANCE_US = 1000000  # 미국 주식 100만원
INITIAL_BALANCE_CRYPTO = 1000000  # 비트코인 100만원
